---
import { getLangFromUrl } from '../i18n/utils';

interface Props {
	date: Date;
	locale?: string;
}

const { date, locale } = Astro.props;
const pageLanguage = getLangFromUrl(Astro.url);
const dateLocale = locale ?? (pageLanguage === 'es' ? 'es-MX' : 'en');
---

<time datetime={date.toISOString()}>
	{
		date.toLocaleDateString(dateLocale, {
			year: 'numeric',
			month: 'short',
			day: 'numeric',
		})
	}
</time>
