---
import Card from './Card.astro';
import { getCollection } from 'astro:content';
import { getLangFromUrl, useTranslatedPath } from '../i18n/utils';
import { getSite } from '../utils/consts';
import { withBase } from '../utils/slugify';

const lang = getLangFromUrl(Astro.url);
const translatePath = useTranslatedPath(lang);
const site = await getSite();
if (!site.visit) {
	throw new Error('Visit information is missing from site-config.yml.');
}

const spaces = (await getCollection('spaces'))
	.filter((space) => space.id.startsWith(`${lang}/`))
	.sort((a, b) => a.id.localeCompare(b.id))
	.slice(0, 2);
const journalEntries = (await getCollection('journal'))
	.filter((entry) => entry.id.startsWith(`${lang}/`))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const copy = {
	es: {
		privateDining: {
			eyebrow: 'Para compartir',
			title: 'Espacios',
			description: 'Descubre espacios íntimos para compartir una comida y celebrar juntos.',
			capacity: (count: number) => `Hasta ${count} personas`,
			link: 'Explorar espacios',
			empty: 'Próximamente compartiremos más información sobre nuestros espacios.',
		},
		journal: {
			eyebrow: 'Desde la cocina',
			title: 'Diario',
			link: 'Leer el diario',
		},
		visit: {
			eyebrow: 'Encuéntranos',
			title: 'Planea tu visita',
			address: 'Dirección',
			publicTransport: 'Cómo llegar',
			hours: 'Horario',
			link: 'Más información',
		},
	},
	en: {
		privateDining: {
			eyebrow: 'Gather together',
			title: 'Spaces',
			description: 'Discover intimate spaces for sharing a meal and celebrating together.',
			capacity: (count: number) => `Up to ${count} guests`,
			link: 'Explore spaces',
			empty: 'Details about our spaces are coming soon.',
		},
		journal: {
			eyebrow: 'From the kitchen',
			title: 'Journal',
			link: 'Read the journal',
		},
		visit: {
			eyebrow: 'Find us',
			title: 'Plan your visit',
			address: 'Address',
			publicTransport: 'Public transit',
			hours: 'Hours',
			link: 'Visit details',
		},
	},
};

const text = copy[lang];
const visit = site.visit;
---

{spaces.length > 0 && (
<section class="content-shell space-y-6 border-t border-border py-12">
	<header class="flex flex-wrap items-end justify-between gap-4">
		<div class="space-y-2">
			<p class="eyebrow m-0">{text.privateDining.eyebrow}</p>
			<h2 class="section-title">{text.privateDining.title}</h2>
			<p class="m-0 max-w-2xl text-muted">{text.privateDining.description}</p>
		</div>
		<a class="text-sm font-medium text-ink underline underline-offset-4" href={withBase(translatePath('/spaces/'))}>
			{text.privateDining.link}
		</a>
	</header>

		<div class="grid gap-5 sm:grid-cols-2">
		{spaces.map((space) => (
			<Card
				title={space.data.name}
				href={withBase(translatePath('/spaces/'))}
				description={space.data.description}
				image={space.data.image}
				imageAlt={space.data.name}
			>
				<p class="m-0">{text.privateDining.capacity(space.data.capacity)}</p>
			</Card>
		))}
	</div>
</section>
)}

{journalEntries.length > 0 && (
<section class="content-shell space-y-6 border-t border-border py-12">
	<header class="flex flex-wrap items-end justify-between gap-4">
		<div class="space-y-2">
			<p class="eyebrow m-0">{text.journal.eyebrow}</p>
			<h2 class="section-title">{text.journal.title}</h2>
		</div>
		<a class="text-sm font-medium text-ink underline underline-offset-4" href={withBase(translatePath('/journal/'))}>
			{text.journal.link}
		</a>
	</header>

	<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
		{journalEntries.map((entry) => {
			const slug = entry.id.replace(/^[^/]+\//, '');
			return (
				<Card
					title={entry.data.title}
					href={withBase(translatePath(`/journal/${slug}/`))}
					description={entry.data.description}
					date={entry.data.pubDate}
					image={entry.data.heroImage}
					imageAlt={entry.data.title}
				/>
			);
		})}
	</div>
</section>
)}

<section class="content-shell space-y-6 border-t border-border py-12">
	<header class="space-y-2">
		<p class="eyebrow m-0">{text.visit.eyebrow}</p>
		<h2 class="section-title">{text.visit.title}</h2>
	</header>

	<div class="grid gap-6 md:grid-cols-3">
		<div class="space-y-2">
			<h3 class="item-title">{text.visit.address}</h3>
			<p class="m-0 text-muted">{visit.address[lang]}</p>
		</div>
		<div class="space-y-2">
			<h3 class="item-title">{text.visit.publicTransport}</h3>
			<ul class="m-0 list-disc space-y-2 pl-5 text-muted">
				{[visit.publicTransport[lang]].flat().map((recommendation) => <li>{recommendation}</li>)}
			</ul>
		</div>
		<div class="space-y-2">
			<h3 class="item-title">{text.visit.hours}</h3>
			<ul class="m-0 grid gap-1 p-0 text-sm text-muted">
				{visit.hours[lang].map((entry) => (
					<li class="flex justify-between gap-2">
						<span>{entry.day}</span>
						<span class="text-right">{entry.schedule}</span>
					</li>
				))}
			</ul>
		</div>
	</div>

	<a class="inline-flex text-sm font-medium text-ink underline underline-offset-4" href={withBase(translatePath('/visit/'))}>
		{text.visit.link}
	</a>
</section>
