---
import PageLayout from '../layouts/PageLayout.astro';
import MenuList from './MenuList.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';
import { withBase } from '../utils/slugify';

type Language = 'es' | 'en';

interface Props {
	lang: Language;
}

const { lang } = Astro.props;
const site = await getSite();
const menus = await getCollection('menus');
const menuDetails = menus
	.filter((entry) => entry.id.startsWith(`${lang}/`))
	.sort((a, b) => a.data.order - b.data.order);
const menuItems = await getCollection('menu');
const menuIds = new Set(menus.map((menu) => `${menu.id.split('/')[0]}/${menu.data.id}`));
const orphanedItems = menuItems.filter(
	(item) => !menuIds.has(`${item.id.split('/')[0]}/${item.data.menu}`),
);
if (orphanedItems.length > 0) {
	throw new Error(`Menu items reference unknown menus: ${orphanedItems.map((item) => item.id).join(', ')}.`);
}
const copy = {
	es: {
		title: 'Nuestros menús',
		eyebrow: site.tagline?.es ?? '',
		description: 'Elige un menú y descubre los platillos de temporada de nuestra cocina.',
		caption: 'En la mesa',
	},
	en: {
		title: 'Our menus',
		eyebrow: site.tagline?.en ?? '',
		description: 'Choose a menu to explore seasonal dishes from our kitchen.',
		caption: 'On the table',
	},
};
const text = copy[lang];
---

<PageLayout title={`${text.title} · ${site.title}`} description={text.description}>
	<MenuList
		eyebrow={text.eyebrow}
		title={text.title}
		titleTag="h1"
		showTitle={false}
		centerVertically={true}
		description={text.description}
		caption={text.caption}
		items={menuDetails.map((details) => ({
			title: details.data.title,
			description: details.data.description,
			href: withBase(`${lang === 'es' ? '' : '/en'}/menu/${details.data.id}/`),
		}))}
	/>
</PageLayout>
