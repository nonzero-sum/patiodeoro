---
import { getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);

const copy = {
	es: {
		eyebrow: 'Una mesa con historia',
		title: 'Nuestra historia',
		intro: 'Cocina mexicana contemporánea, marcada por las estaciones y pensada para compartir.',
		place: {
			eyebrow: 'El lugar',
			title: 'Un lugar para reunirnos',
			paragraphs: [
				'The Menu nació como un espacio acogedor para disfrutar de la cocina mexicana contemporánea en Zacatlán. Nuestros menús siguen las estaciones y celebran los ingredientes y las tradiciones que hacen tan diversa la cocina mexicana.',
				'Ya sea para cenar, celebrar o asistir a un evento, queremos que nuestra mesa invite a disfrutar buena comida, conversar y compartir el tiempo.',
			],
		},
		chef: {
			eyebrow: 'La cocina',
			title: 'La mirada del chef',
			paragraphs: [
				'La historia de nuestro chef se cuenta a través de los menús: respeto por los ingredientes mexicanos, atención a cada estación y curiosidad por descubrir nuevos matices en sabores familiares.',
				'En lugar de seguir un guion fijo, la cocina deja que cada estación inspire lo que llega a la mesa. El resultado es una cocina mexicana contemporánea, arraigada en la tradición y abierta al descubrimiento.',
			],
		},
	},
	en: {
		eyebrow: 'A table with a story',
		title: 'Our story',
		intro: 'Contemporary Mexican cuisine, shaped by the seasons and made to be shared.',
		place: {
			eyebrow: 'The place',
			title: 'A place to gather',
			paragraphs: [
				'The Menu was imagined as a welcoming place to experience contemporary Mexican cuisine in Zacatlán. Our menus follow the seasons and draw on the ingredients and traditions that make Mexican cooking so diverse.',
				'Whether guests arrive for dinner, a celebration, or an event, we want the table to make room for good food, easy conversation, and time together.',
			],
		},
		chef: {
			eyebrow: 'The kitchen',
			title: 'The chef’s point of view',
			paragraphs: [
				"Our chef’s story is told through the menus: a respect for Mexican ingredients, an eye for the changing seasons, and the curiosity to see familiar flavors from a new angle.",
				'Rather than follow a fixed script, the kitchen lets each season shape what comes to the table. The result is contemporary Mexican cooking grounded in tradition and open to discovery.',
			],
		},
	},
};

const text = copy[lang];
---

<section class="content-shell space-y-8 py-12">
	<header class="max-w-3xl space-y-3">
		<p class="eyebrow m-0">{text.eyebrow}</p>
		<h1 class="page-title">{text.title}</h1>
		<p class="m-0 text-lg text-muted">{text.intro}</p>
	</header>

	<div class="grid gap-5 md:grid-cols-2">
		{[text.place, text.chef].map((section) => (
			<article class="space-y-4 rounded-[20px] border border-border bg-surface p-6 sm:p-8">
				<header class="space-y-2">
					<p class="eyebrow m-0">{section.eyebrow}</p>
					<h2 class="subsection-title">{section.title}</h2>
				</header>
				{section.paragraphs.map((paragraph) => <p class="m-0 text-muted">{paragraph}</p>)}
			</article>
		))}
	</div>
</section>
