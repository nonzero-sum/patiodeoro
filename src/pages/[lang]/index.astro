---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import HomeMenus from '../../components/HomeMenus.astro';
import HomeSections from '../../components/HomeSections.astro';
import HomeReservation from '../../components/HomeReservation.astro';
import Testimonials from '../../components/Testimonials.astro';
import { getSite } from '../../utils/consts';

export function getStaticPaths() {
	return [{ params: { lang: 'en' } }];
}

const site = await getSite();
---

<PageLayout title={site.title}>
	<Hero
		eyebrow="Zacatlán, Puebla"
		title="Contemporary Mexican cuisine"
		displayWord="Contemporary"
		description="Seasonal menus, private dining, and gatherings in a warm, intimate setting."
		actions={[
			{ label: 'Explore menus', href: '/en/menu' },
			{ label: 'Plan your visit', href: '/en/visit' },
		]}
	/>

	<HomeMenus />
	<HomeSections />

	<Testimonials eyebrow="Guest notes" title="What our guests say" />
	<HomeReservation />
</PageLayout>
