---
import { getCollection } from 'astro:content';
import MenuPage from '../../../components/MenuPage.astro';

export async function getStaticPaths() {
	const menus = await getCollection('menus');
	return menus
		.filter((entry) => entry.id.startsWith('en/'))
		.map((entry) => ({
			params: { lang: 'en', meal: entry.data.id },
			props: { lang: 'en', menuId: entry.data.id },
		}));
}

const { lang, menuId } = Astro.props;
---

<MenuPage lang={lang} menuId={menuId} />
