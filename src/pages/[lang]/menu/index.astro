---
import { getCollection } from 'astro:content';
import MenuIndex from '../../../components/MenuIndex.astro';

export async function getStaticPaths() {
	const menus = await getCollection('menus');
	return menus.some((entry) => entry.id.startsWith('en/'))
		? [{ params: { lang: 'en' }, props: { lang: 'en' } }]
		: [];
}

const { lang } = Astro.props;
---

<MenuIndex lang={lang} />
