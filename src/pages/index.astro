---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import HomeMenus from '../components/HomeMenus.astro';
import HomeSections from '../components/HomeSections.astro';
import HomeReservation from '../components/HomeReservation.astro';
import Sponsors from '../components/Sponsors.astro';
import Testimonials from '../components/Testimonials.astro';
import { getSite } from '../utils/consts';
const site = await getSite();
---

<PageLayout
	title={site.title}
>
	<Hero
		eyebrow="Zacatlán, Puebla"
		title="Cocina mexicana contemporánea"
		displayWord="Contemporánea"
		description="Menús de temporada, comedor privado y encuentros en un espacio cálido e íntimo."
		actions={[
			{ label: 'Explora nuestros menús', href: '/menu' },
			{ label: 'Planea tu visita', href: '/visit' },
		]}
	/>

	<HomeMenus />
	<HomeSections />

	<Testimonials
		eyebrow="Lo que dicen nuestros visitantes"
		title="Voces de nuestra mesa"
	/>
	<HomeReservation />

</PageLayout>
